  "protocols": [
    {
      "protocol_id": "PROTO-ANEMIA-01",
      "condition_id": "ANEMIA_MICROCYTIC",
      "condition_name": "Microcytic Anemia & Erythrocyte Depletion",
      "category": "Hematology",
      "summary_narrative": "Sub-optimal hemoglobin and red cell indices indicate potential iron deficiency anemia or impaired hemoglobin synthesis.",
      "dietary_guidelines": [
        "Increase dietary iron intake via bioavailable heme sources (lean poultry, fish) and non-heme sources (lentils, chickpeas, fortified whole grains).",
        "Co-ingest ascorbic acid (Vitamin C: citrus, bell peppers, tomatoes) to enhance non-heme iron absorption."
      ],
      "activity_guidelines": [
        "Engage in low-to-moderate exertion activities with scheduled rest intervals to avoid hypoxemic fatigue."
      ],
      "contraindications_to_avoid": [
        "Avoid consuming polyphenols, tannins (tea/coffee), and calcium supplements concurrently with iron-rich meals as they inhibit bioavailability."
      ],
      "physician_discussion_questions": [
        "Would you recommend evaluating complete iron indices (serum ferritin, transferrin saturation, TIBC)?",
        "Should therapeutic oral iron supplementation be initiated?"
      ],
      "escalation_flag": false
    },
    {
      "protocol_id": "PROTO-CARDIO-LIPID-01",
      "condition_id": "ATHEROGENIC_DYSLIPIDEMIA",
      "condition_name": "Atherogenic Dyslipidemia & Elevated Apolipoproteins",
      "category": "Cardiovascular / Lipids",
      "summary_narrative": "Elevated atherogenic circulating lipids (LDL / Total Cholesterol / Triglycerides) increase arterial endothelial plaque accumulation risk.",
      "dietary_guidelines": [
        "Adopt an anti-inflammatory Mediterranean dietary framework emphasizing extra virgin olive oil, nuts, and omega-3 polyunsaturated fatty acids.",
        "Incorporate 25-35g of daily dietary fiber including viscous soluble fiber (psyllium, oat beta-glucan) to enhance bile acid excretion."
      ],
      "activity_guidelines": [
        "Achieve at least 150 minutes per week of moderate-intensity aerobic cardiovascular exercise to stimulate lipoprotein lipase activity and raise HDL."
      ],
      "contraindications_to_avoid": [
        "Eliminate industrial trans-fatty acids and restrict dietary saturated fats to less than 7% of daily caloric intake.",
        "Minimize ultra-processed simple carbohydrates and high-fructose corn syrups that accelerate hepatic triglyceride synthesis."
      ],
      "physician_discussion_questions": [
        "Should we assess a formal 10-year ASCVD (Atherosclerotic Cardiovascular Disease) risk calculation?",
        "Are lipid-lowering pharmacological interventions (such as HMG-CoA reductase inhibitors) indicated at this baseline?"
      ],
      "escalation_flag": false
    },
    {
      "protocol_id": "PROTO-METABOLIC-DM-01",
      "condition_id": "IMPAIRED_GLYCEMIA",
      "condition_name": "Impaired Glycemic Regulation & Insulin Resistance",
      "category": "Metabolic & Glycemia",
      "summary_narrative": "Elevated fasting blood glucose and glycated hemoglobin indices reflect impaired insulin sensitivity and disordered carbohydrate metabolism.",
      "dietary_guidelines": [
        "Emphasize complex carbohydrates with low glycemic index/load, pairing carbs with lean protein and fiber to blunt postprandial glucose excursions."
      ],
      "activity_guidelines": [
        "Incorporate 10-15 minute post-meal ambulatory walks and bi-weekly resistance training to stimulate insulin-independent GLUT4 glucose uptake."
      ],
      "contraindications_to_avoid": [
        "Avoid sugar-sweetened beverages, refined starches, and rapid-digesting baked goods that trigger acute glycemic spikes."
      ],
      "physician_discussion_questions": [
        "Would formal repeat testing (2-hour oral glucose tolerance test or confirmatory HbA1c) be appropriate?",
        "Should early metabolic therapeutic agents or diabetes self-management education be initiated?"
      ],
      "escalation_flag": false
    },
    {
      "protocol_id": "PROTO-RENAL-CLEARANCE-01",
      "condition_id": "RENAL_FILTRATION_STRAIN",
      "condition_name": "Renal Clearance Impairment & Glomerular Strain",
      "category": "Kidney Function",
      "summary_narrative": "Elevated serum creatinine and reduced glomerular filtration rate indicate compromised renal excretory function.",
      "dietary_guidelines": [
        "Maintain adequate, consistent hydration (2.0 to 2.5 L/day unless restricted for cardiorenal volume overload).",
        "Moderate dietary sodium intake (< 2,000 mg/day) and avoid excessive concentrated protein loading."
      ],
      "activity_guidelines": [
        "Maintain light-to-moderate physical conditioning while avoiding severe dehydrating rhabdomyolysis-inducing exertion."
      ],
      "contraindications_to_avoid": [
        "Avoid unprescribed non-steroidal anti-inflammatory drugs (NSAIDs such as ibuprofen or naproxen) which cause renal vasoconstriction."
      ],
      "physician_discussion_questions": [
        "Should a spot urine albumin-to-creatinine ratio (uACR) test be performed to assess microalbuminuria?",
        "Are my current medications appropriately dosed for my renal filtration baseline?"
      ],
      "escalation_flag": true
    },
    {
      "protocol_id": "PROTO-HEPATIC-INJURY-01",
      "condition_id": "HEPATIC_TRANSAMINASE_ELEVATION",
      "condition_name": "Hepatocellular Stress & Transaminase Elevation",
      "category": "Liver Function",
      "summary_narrative": "Elevated ALT/AST enzymes point to hepatocyte membrane leakage and hepatic inflammation.",
      "dietary_guidelines": [
        "Adopt an antioxidant-rich whole-food diet low in refined carbohydrates to mitigate hepatic steatosis."
      ],
      "activity_guidelines": [
        "Target regular moderate aerobic exercise to reduce visceral and intrahepatic adipose tissue."
      ],
      "contraindications_to_avoid": [
        "Abstain strictly from alcoholic beverages and minimize hepatically metabolized medications (e.g. excessive acetaminophen)."
      ],
      "physician_discussion_questions": [
        "Would you recommend a diagnostic hepatic ultrasound to screen for fatty liver changes or biliary pathology?",
        "Should viral hepatitis serologies be ordered?"
      ],
      "escalation_flag": false
    },
    {
      "protocol_id": "PROTO-THYROID-DYSREG-01",
      "condition_id": "THYROID_AXIS_DYSREGULATION",
      "condition_name": "Hypothalamic-Pituitary-Thyroid Axis Dysregulation",
      "category": "Endocrine & Thyroid",
      "summary_narrative": "Out-of-range TSH levels reflect pituitary feedback dysregulation regarding systemic metabolic rate.",
      "dietary_guidelines": [
        "Ensure balanced micronutrient adequacy including selenium, zinc, and dietary iodine."
      ],
      "activity_guidelines": [
        "Tailor physical exertion to energy thresholds, pacing physical workouts according to fatigue levels."
      ],
      "contraindications_to_avoid": [
        "Avoid unmonitored high-dose iodine supplements or thyroid glandular extracts without endocrine supervision."
      ],
      "physician_discussion_questions": [
        "Should free T4 and free T3 levels be evaluated along with thyroid peroxidase (anti-TPO) antibodies?"
      ],
      "escalation_flag": false
    }
